--- a/hw/arm/mps2.c
+++ b/hw/arm/mps2.c
@@ -44,6 +44,8 @@
 #include "hw/misc/mps2-fpgaio.h"
 #include "hw/ssi/pl022.h"
 #include "hw/i2c/arm_sbcon_i2c.h"
+#include "hw/i2c/jm_i2c.h"
+#include "hw/nvram/eeprom_at24c.h"
 #include "hw/net/lan9118.h"
 #include "net/net.h"
 #include "hw/watchdog/cmsdk-apb-watchdog.h"
@@ -459,6 +461,15 @@
     }
     create_unimplemented_device("i2s", 0x40024000, 0x400);
 
+    /* Example controller from the bootloader project: jm-i2c at 0x40030000 with a 256-byte
+     * AT24C EEPROM (7-bit address 0x50) on its bus. Other devices: -device <type>,bus=<id>. */
+    {
+        DeviceState *jm = sysbus_create_simple(TYPE_JM_I2C, 0x40030000, NULL);
+        BusState *jmbus = qdev_get_child_bus(jm, "i2c");
+
+        at24c_eeprom_init(I2C_BUS(jmbus), 0x50, 256);
+    }
+
     /* In hardware this is a LAN9220; the LAN9118 is software compatible
      * except that it doesn't support the checksum-offload feature.
      */
